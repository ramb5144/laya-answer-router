# Copy this file to .env and add your own OpenAI API key.
OPENAI_API_KEY=

# Shared secret for the Claude Desktop extension. Generate one with:
# openssl rand -hex 32
LAYA_MCP_TOKEN=
# Codex can alternatively read the same value from:
# ~/.config/laya-answer-router/mcp-token

# Accuracy/latency lanes selected by Laya.
OPENAI_FAST_MODEL=gpt-5.6-terra
OPENAI_DEEP_MODEL=gpt-6-astra

# Optional overrides.
# LAYA_PYTHON=/absolute/path/to/python
# LAYA_MODEL_PATH=/absolute/path/to/cached/laya/checkpoint
